{
  "name": "florzytech-tracker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "postinstall": "svelte-kit sync",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "test:unit": "vitest run --config vitest.config.ts tests/unit",
    "test:integration": "vitest run --config vitest.config.ts tests/integration",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:db:reset": "node tests/utils/db-reset.mjs",
    "test:db:seed": "node tests/utils/seed-fixtures.mjs",
    "test:snapshot:export": "node tests/utils/export-prod-snapshot.mjs",
    "test:setup": "npm run test:db:reset && npm run test:db:seed"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@sveltejs/adapter-node": "^5.3.2",
    "@sveltejs/kit": "^2.43.2",
    "@types/node": "^22.7.0",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.6.1",
    "postcss": "^8.4.47",
    "prisma": "^5.19.1",
    "svelte": "^5.1.0",
    "svelte-check": "^4.0.4",
    "tailwindcss": "^3.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^6.3.0",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
