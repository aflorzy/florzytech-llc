// Prisma schema for FlorzyTech Tracker

generator client {
  provider = "prisma-client-js"
}

model Income {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  archivedAt DateTime?

  date        DateTime
  type        IncomeType
  amountCents Int

  // Optional associations
  device   Device? @relation(fields: [deviceId], references: [id])
  deviceId String?

  channel   SalesChannel? @relation(fields: [channelId], references: [id])
  channelId String?

  category   Category? @relation(fields: [categoryId], references: [id])
  categoryId String?

  // Fees/Shipping/Tax
  platformFeesCents     Int @default(0)
  paymentFeesCents      Int @default(0)
  shippingRevenueCents  Int @default(0)
  shippingCostCents     Int @default(0)
  taxCollectedCents     Int @default(0)
  notes                 String?

  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id])
  workOrderId String?

  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId String?
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IncomeType {
  SALE
  SERVICE
  DEPOSIT
}

enum DeviceStatus {
  PURCHASED
  AWAITING_SHIPMENT
  ARRIVED
  DIAGNOSING
  WAITING_PARTS
  REPAIRING
  READY
  LISTED
  SOLD
  SHIPPED
  DELIVERED
  DONOR // stripped for parts; never sold
}

enum AllocationMethod {
  PROPORTIONAL_SUBTOTAL
  EVEN
  MANUAL
}

enum WorkOrderStatus {
  OPEN
  WAITING_PARTS
  IN_PROGRESS
  READY
  DELIVERED
  CANCELLED
}

enum WorkOrderTargetAction {
  RETURN_TO_CUSTOMER
  SELL
}

enum WorkOrderDeviceRole {
  PRIMARY
  DONOR
  ACCESSORY
}

enum WorkOrderItemType {
  PART
  LABOR
  NOTE
}

model Device {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  archivedAt DateTime?

  sku                String       @unique
  make               String
  model              String
  serial             String?
  purchasePriceCents Int          @default(0)
  purchaseDate       DateTime?
  source             String? // Freeform or future relation to Vendor
  condition          String?
  notes              String?
  status             DeviceStatus @default(PURCHASED)

  expenses Expense[]
  incomes  Income[]
  workOrderDevices WorkOrderDevice[]
  workOrderItems   WorkOrderItem[]
  harvestedParts   PartInventoryMovement[]
}

model Vendor {
  id        String   @id @default(uuid())
  name      String   @unique
  type      String? // e.g., marketplace, local_store, supplier
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  archivedAt DateTime?

  expenses Expense[]
}

model SalesChannel {
  id        String   @id @default(uuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incomes Income[]
}

model Category {
  id      String    @id @default(uuid())
  name    String    @unique
  kind    String // 'expense' or 'income' for future proofing
  active  Boolean   @default(true)
  Expense Expense[]
  Income  Income[]
}

model PaymentMethod {
  id      String    @id @default(uuid())
  name    String    @unique
  active  Boolean   @default(true)
  Expense Expense[]
}

model Expense {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  archivedAt DateTime?

  date        DateTime
  amountCents Int
  // Allocation breakdown (for split receipts)
  subtotalCents   Int      @default(0)
  taxCents        Int      @default(0)
  shippingCents   Int      @default(0)
  otherFeesCents  Int      @default(0)
  splitGroupId    String?
  allocationMethod AllocationMethod?
  notes       String?
  receiptNotes String? // split receipts: one note for the whole receipt, repeated on each line
  vendorOrderNumber String?

  // Relations
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])

  deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id])

  partMovements PartInventoryMovement[]
}

model Part {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  archivedAt DateTime?

  name          String
  sku           String? @unique
  partNumber    String?
  quantity      Int     @default(0)
  unitCostCents Int? // legacy; not used for average costing
  averageCostCents Int @default(0)
  notes         String?
  url           String?
  workOrderItems WorkOrderItem[]
  movements     PartInventoryMovement[]
}

model Customer {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  archivedAt DateTime?

  name       String
  email      String?
  phone      String?
  addressLine1 String?
  addressLine2 String?
  city       String?
  state      String?
  postalCode String?
  notes      String?

  incomes Income[]
  workOrders WorkOrder[]
}

model WorkOrder {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  archivedAt DateTime?

  code       String   @unique
  status     WorkOrderStatus @default(OPEN)
  targetAction WorkOrderTargetAction @default(RETURN_TO_CUSTOMER)
  notes      String?

  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId String?

  // Set by the first payment recorded against the work order, or by "Mark invoiced".
  // From then on part lines use the markup stored here instead of the current setting.
  // A work order invoiced before line prices existed has a date and no stored markup:
  // its part lines stay unpriced unless a price is typed.
  invoicedAt        DateTime?
  invoicedMarkupBps Int?

  devices WorkOrderDevice[]
  items   WorkOrderItem[]
  incomes Income[]

  partMovements PartInventoryMovement[]
}

model WorkOrderDevice {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  archivedAt DateTime?

  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  workOrderId String

  device   Device @relation(fields: [deviceId], references: [id])
  deviceId String

  role WorkOrderDeviceRole @default(PRIMARY)

  // Whether the device's own expenses (purchase etc.) count against this work order.
  // On for at most one work order per device, so a device that comes back as a
  // customer repair is not charged its purchase cost again.
  // Always off for a DONOR row: a donor's cost comes back through the parts taken from it.
  includeDeviceCost Boolean @default(true)

  // What the customer is charged for this device on this work order
  priceCents Int?
}

model WorkOrderItem {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  archivedAt DateTime?

  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  workOrderId String

  type WorkOrderItemType

  // PART consumption or general note/labor lines
  part    Part?   @relation(fields: [partId], references: [id])
  partId  String?
  device  Device? @relation(fields: [deviceId], references: [id])
  deviceId String?

  quantity Int? @default(0) // for PART
  unitCostCentsSnapshot Int? @default(0) // captured at consumption
  // PART: customer price per unit typed by hand. Null follows the parts markup.
  manualUnitPriceCents Int?

  // For LABOR or NOTE
  description String?
  amountCents Int? @default(0)
}



// App-wide settings: a single row with id 1. Read through src/lib/server/settings.ts,
// which falls back to the column defaults when the row has not been written yet.
model Settings {
  id        Int      @id @default(1)
  updatedAt DateTime @updatedAt

  // Default markup on parts, in basis points (3000 = 30%)
  partsMarkupBps Int @default(3000)
}

enum PartInventoryMovementType {
  RECEIPT
  CONSUME
  ADJUSTMENT
}

model PartInventoryMovement {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  archivedAt DateTime?

  type PartInventoryMovementType

  part   Part   @relation(fields: [partId], references: [id])
  partId String

  // Positive for RECEIPT/ADJUSTMENT up; negative represented by type+quantity semantics; we keep quantity positive and infer sign by type.
  quantity Int

  // Cost for this movement (per unit and total)
  unitCostCents  Int
  totalCostCents Int

  // Optional associations for traceability
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id])
  workOrderId String?

  expense   Expense? @relation(fields: [expenseId], references: [id])
  expenseId String?

  // Donor device the parts were pulled from (RECEIPT only). The movement's cost is
  // taken off the donor and carried by the parts stock instead.
  sourceDevice   Device? @relation(fields: [sourceDeviceId], references: [id])
  sourceDeviceId String?

  notes String?
}
